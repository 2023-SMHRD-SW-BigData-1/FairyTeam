# ── DB 접속 (application.properties 의 DB 부분) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fairy
# 클라우드 DB가 SSL 요구 시 true
DB_SSL=false

# ── 인증 ──
# 운영에선 반드시 길고 무작위한 값으로 교체 (노출되면 누구나 토큰 위조 가능)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── 서버 ──
PORT=4000
# 프론트 주소(들). 비우면 개발용으로 전부 허용. 운영은 콤마로 도메인 나열.
CORS_ORIGIN=
